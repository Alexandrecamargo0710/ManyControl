<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ManyControl.ViewModels"
             xmlns:models="clr-namespace:ManyControl.Models"
             x:Class="ManyControl.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0b0f19"
             Title="Início">

    <ContentPage.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="#374151" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">
                <!-- Cabeçalho Oficial ManyControl -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,4,0,2">
                    <Image Source="app_logo.png" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="ManyControl" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Gestão Financeira e Sincronização em Nuvem" FontSize="12" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#111827">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sincronização" TextColor="White" FontSize="14" />
                        <Label Text="{Binding LastSyncText}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding LastSyncModeText}" TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="{Binding SyncStatusText}" TextColor="#A7F3D0" FontSize="12" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Sincronizar agora" HeightRequest="40" Padding="0" FontSize="13" Command="{Binding SyncCommand}" />
                            <Button Grid.Column="1" Text="Importar backup" HeightRequest="40" Padding="0" FontSize="13" BackgroundColor="#374151" Command="{Binding ImportSyncCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Seletor de Mês do Início -->
                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#111827" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Button Grid.Column="0"
                                    Text="◀"
                                    WidthRequest="44" HeightRequest="44" Padding="0" CornerRadius="10"
                                    BackgroundColor="#374151" TextColor="White" FontSize="16"
                                    Command="{Binding MesAnteriorCommand}" />

                            <Label Grid.Column="1"
                                   Text="{Binding MesAnoTexto}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   LineBreakMode="NoWrap" />

                            <Button Grid.Column="2"
                                    Text="▶"
                                    WidthRequest="44" HeightRequest="44" Padding="0" CornerRadius="10"
                                    BackgroundColor="#374151" TextColor="White" FontSize="16"
                                    Command="{Binding ProximoMesCommand}" />
                        </Grid>

                        <Button Text="Ir para o mês atual"
                                HeightRequest="32" Padding="14,0" FontSize="12" CornerRadius="8"
                                BackgroundColor="#1F2937" TextColor="#9CA3AF"
                                HorizontalOptions="Center"
                                Command="{Binding MesAtualCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Resumo Financeiro do Mês & Saldo Geral -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#1F2937" Grid.Row="0" Grid.Column="0" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Balanço do Mês" TextColor="#9CA3AF" FontSize="12" />
                            <Label Text="{Binding BalancoMes, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#1E1B4B" Grid.Row="0" Grid.Column="1" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Saldo Geral (Conta)" TextColor="#A5B4FC" FontSize="12" />
                            <Label Text="{Binding Saldo, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#065F46" Grid.Row="1" Grid.Column="0" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Receitas do Mês" TextColor="#D1FAE5" FontSize="12" />
                            <Label Text="{Binding ReceitasMes, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#991B1B" Grid.Row="1" Grid.Column="1" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas do Mês" TextColor="#FEE2E2" FontSize="12" />
                            <Label Text="{Binding DespesasMes, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#451A03" Grid.Row="2" Grid.Column="0" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="A Pagar (Pendente)" TextColor="#FDE68A" FontSize="12" />
                            <Label Text="{Binding DespesasPendentesMes, StringFormat='R$ {0:N2}'}" TextColor="#FBBF24" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#064E3B" Grid.Row="2" Grid.Column="1" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Já Pago" TextColor="#A7F3D0" FontSize="12" />
                            <Label Text="{Binding DespesasPagasMes, StringFormat='R$ {0:N2}'}" TextColor="#34D399" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Adicionar receita" FontSize="20" FontAttributes="Bold" />
                        <Entry Text="{Binding ReceitaDescricao}" Placeholder="Descrição" />
                        <Entry Text="{Binding ReceitaValor}" Placeholder="Valor" Keyboard="Numeric" />
                        <DatePicker Date="{Binding ReceitaData}" />
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Salvar receita" Command="{Binding SalvarReceitaCommand}" />
                            <Button Text="Cancelar" Command="{Binding CancelarReceitaCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Adicionar despesa" FontSize="20" FontAttributes="Bold" />
                        <Entry Text="{Binding DespesaDescricao}" Placeholder="Descrição" />
                        <Entry Text="{Binding DespesaValor}" Placeholder="Valor" Keyboard="Numeric" />
                        <DatePicker Date="{Binding DespesaData}" />
                        <DatePicker Date="{Binding DespesaVencimento}" />
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                                <Switch IsToggled="{Binding DespesaRecorrente}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Despesa recorrente" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                            </Grid>
                            <Label Text="Ative caso essa despesa se repete todo mês" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                                <Switch IsToggled="{Binding DespesaPaga}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Despesa já paga" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                            </Grid>
                            <Label Text="Marque se esta conta já foi quitada" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Salvar despesa" Command="{Binding SalvarDespesaCommand}" />
                            <Button Text="Cancelar" Command="{Binding CancelarDespesaCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Despesas do mês" FontSize="18" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding DespesasRecentes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Despesa">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <!-- Badge Interativo de Status Paga/Pendente -->
                                                <Border Grid.Column="0"
                                                        StrokeThickness="0"
                                                        Padding="8,3"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Paga}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="#064E3B" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Paga}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="#451A03" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AlternarStatusPagamentoCommand}"
                                                                             CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label FontSize="10" FontAttributes="Bold" VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Paga}" Value="True">
                                                                <Setter Property="Text" Value="✓ PAGA" />
                                                                <Setter Property="TextColor" Value="#34D399" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Paga}" Value="False">
                                                                <Setter Property="Text" Value="⏳ PENDENTE" />
                                                                <Setter Property="TextColor" Value="#FBBF24" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>

                                                <Label Grid.Column="1" Text="{Binding Descricao}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding Valor, StringFormat='- R$ {0:N2}'}" TextColor="#F87171" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding Vencimento, StringFormat='Venc.: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" />
                                                    <Label Text="• Recorrente" FontSize="11" TextColor="#A78BFA" IsVisible="{Binding Recorrente}" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Editar" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#2563EB" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EditarDespesaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="Excluir" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#DC2626" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ExcluirDespesaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Receitas do mês" FontSize="18" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding ReceitasRecentes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Receita">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Descricao}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Valor, StringFormat='+ R$ {0:N2}'}" TextColor="#34D399" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Editar" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#2563EB" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EditarReceitaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="Excluir" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#DC2626" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ExcluirReceitaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsEditModalVisible}" BackgroundColor="#AA000000" Padding="24" ZIndex="10">
            <Border Style="{StaticResource CardBorderStyle}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding EditModalTitle}" FontSize="22" FontAttributes="Bold" />

                    <Entry Text="{Binding EditDescricao}" Placeholder="Descrição" />
                    <Entry Text="{Binding EditValor}" Placeholder="Valor" Keyboard="Numeric" />
                    <DatePicker Date="{Binding EditData}" />

                    <VerticalStackLayout IsVisible="{Binding IsEditRecorrenteVisible}" Spacing="4">
                        <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                            <Switch IsToggled="{Binding EditRecorrente}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Despesa recorrente" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                        </Grid>
                        <Label Text="Ative caso essa despesa se repete todo mês" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding IsEditPagaVisible}" Spacing="4">
                        <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                            <Switch IsToggled="{Binding EditPaga}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Despesa já paga" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                        </Grid>
                    </VerticalStackLayout>
                    <DatePicker IsVisible="{Binding IsEditVencimentoVisible}" Date="{Binding EditVencimento}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Atualizar" Command="{Binding SalvarEdicaoModalCommand}" />
                        <Button Text="Cancelar" Command="{Binding FecharEdicaoModalCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Overlay Bloqueante de Atualização em Tela Cheia -->
        <Grid IsVisible="{Binding IsDownloadingUpdate}"
              ZIndex="9999"
              BackgroundColor="#F20B0F19"
              InputTransparent="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border BackgroundColor="#111827"
                    Stroke="#374151"
                    StrokeThickness="1"
                    Padding="32"
                    MaximumWidthRequest="420"
                    Margin="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18" HorizontalOptions="Center">
                    <Border BackgroundColor="#0284C7"
                            StrokeThickness="0"
                            WidthRequest="64"
                            HeightRequest="64"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>
                        <Label Text="↓"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Atualizando ManyControl"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label Text="Baixando os arquivos da nova versão...&#10;O aplicativo será reiniciado automaticamente ao concluir."
                           TextColor="#9CA3AF"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />

                    <ProgressBar Progress="{Binding UpdateProgress}"
                                 ProgressColor="#38BDF8"
                                 HeightRequest="8"
                                 HorizontalOptions="Fill" />

                    <Label Text="{Binding UpdateProgressText}"
                           TextColor="#38BDF8"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
