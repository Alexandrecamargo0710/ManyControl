<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ManyControl.ViewModels"
             xmlns:models="clr-namespace:ManyControl.Models"
             x:Class="ManyControl.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             Title="Início">

    <ContentPage.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="#374151" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">
                <!-- Cabeçalho Oficial ManyControl -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,4,0,2">
                    <Image Source="app_logo.png" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="ManyControl" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Gestão Financeira e Sincronização em Nuvem" FontSize="12" TextColor="#9CA3AF" />
                    </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#111827">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sincronização" TextColor="White" FontSize="14" />
                        <Label Text="{Binding LastSyncText}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding LastSyncModeText}" TextColor="#E5E7EB" FontSize="12" />
                        <Label Text="{Binding SyncStatusText}" TextColor="#A7F3D0" FontSize="12" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Sincronizar agora" HeightRequest="40" Padding="0" FontSize="13" Command="{Binding SyncCommand}" />
                            <Button Grid.Column="1" Text="Importar backup" HeightRequest="40" Padding="0" FontSize="13" BackgroundColor="#374151" Command="{Binding ImportSyncCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#1F2937" Grid.Row="0" Grid.Column="0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Saldo" TextColor="White" FontSize="14" />
                            <Label Text="{Binding Saldo, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#0F766E" Grid.Row="0" Grid.Column="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Receitas" TextColor="White" FontSize="14" />
                            <Label Text="{Binding TotalReceitas, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#7C2D12" Grid.Row="1" Grid.Column="0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Despesas" TextColor="White" FontSize="14" />
                            <Label Text="{Binding TotalDespesas, StringFormat='R$ {0:N2}'}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="#4338CA" Grid.Row="1" Grid.Column="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Categorias" TextColor="White" FontSize="14" />
                            <Label Text="{Binding TotalCategorias}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Adicionar receita" FontSize="20" FontAttributes="Bold" />
                        <Entry Text="{Binding ReceitaDescricao}" Placeholder="Descrição" />
                        <Entry Text="{Binding ReceitaValor}" Placeholder="Valor" Keyboard="Numeric" />
                        <DatePicker Date="{Binding ReceitaData}" />
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Salvar receita" Command="{Binding SalvarReceitaCommand}" />
                            <Button Text="Cancelar" Command="{Binding CancelarReceitaCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Adicionar despesa" FontSize="20" FontAttributes="Bold" />
                        <Entry Text="{Binding DespesaDescricao}" Placeholder="Descrição" />
                        <Entry Text="{Binding DespesaValor}" Placeholder="Valor" Keyboard="Numeric" />
                        <DatePicker Date="{Binding DespesaData}" />
                        <DatePicker Date="{Binding DespesaVencimento}" />
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                                <Switch IsToggled="{Binding DespesaRecorrente}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Despesa recorrente" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                            </Grid>
                            <Label Text="Ative caso essa despesa se repete todo mês" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Salvar despesa" Command="{Binding SalvarDespesaCommand}" />
                            <Button Text="Cancelar" Command="{Binding CancelarDespesaCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Despesas recentes" FontSize="18" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding DespesasRecentes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Despesa">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Descricao}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Valor, StringFormat='- R$ {0:N2}'}" TextColor="#F87171" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Vencimento, StringFormat='Venc.: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Editar" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#2563EB" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EditarDespesaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="Excluir" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#DC2626" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ExcluirDespesaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Receitas recentes" FontSize="18" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding ReceitasRecentes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Receita">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14,10" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Descricao}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Valor, StringFormat='+ R$ {0:N2}'}" TextColor="#34D399" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Label Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Editar" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#2563EB" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EditarReceitaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="Excluir" HeightRequest="30" Padding="12,0" FontSize="11" CornerRadius="6"
                                                            BackgroundColor="#DC2626" TextColor="White"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ExcluirReceitaCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsEditModalVisible}" BackgroundColor="#AA000000" Padding="24" ZIndex="10">
            <Border Style="{StaticResource CardBorderStyle}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding EditModalTitle}" FontSize="22" FontAttributes="Bold" />

                    <Entry Text="{Binding EditDescricao}" Placeholder="Descrição" />
                    <Entry Text="{Binding EditValor}" Placeholder="Valor" Keyboard="Numeric" />
                    <DatePicker Date="{Binding EditData}" />

                    <VerticalStackLayout IsVisible="{Binding IsEditRecorrenteVisible}" Spacing="4">
                        <Grid ColumnDefinitions="48,Auto" ColumnSpacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                            <Switch IsToggled="{Binding EditRecorrente}" Grid.Column="0" WidthRequest="48" MaximumWidthRequest="48" HorizontalOptions="Start" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Despesa recorrente" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" Padding="0" />
                        </Grid>
                        <Label Text="Ative caso essa despesa se repete todo mês" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                    <DatePicker IsVisible="{Binding IsEditVencimentoVisible}" Date="{Binding EditVencimento}" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Atualizar" Command="{Binding SalvarEdicaoModalCommand}" />
                        <Button Text="Cancelar" Command="{Binding FecharEdicaoModalCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
