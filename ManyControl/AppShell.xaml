<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ManyControl.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ManyControl"
    xmlns:views="clr-namespace:ManyControl.Views"
    Title="ManyControl">

    <TabBar>
        <Tab Title="Início" Icon="tab_home.png">
            <ShellContent
                Title="Início"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Extrato" Icon="tab_statement.png">
            <ShellContent
                Title="Extrato"
                ContentTemplate="{DataTemplate views:ExtratoPage}"
                Route="ExtratoPage" />
        </Tab>

        <Tab Title="Sincronização" Icon="tab_sync.png">
            <ShellContent
                Title="Sincronização"
                ContentTemplate="{DataTemplate views:ConfiguracoesPage}"
                Route="ConfiguracoesPage" />
        </Tab>
    </TabBar>

</Shell>
